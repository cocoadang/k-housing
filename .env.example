# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# 국토교통부 아파트매매 실거래자료 OpenAPI 인증키 (공공데이터포털 data.go.kr)
MOLIT_API_KEY=""

# 한국부동산원(R-ONE) 부동산통계 OpenAPI 인증키
R_ONE_API_KEY=""

# Google Maps Platform JavaScript API Key
# Note: Injected into process.env by AI Studio Secrets; served to client via /api/config/maps.
# Restrict via Google Cloud Console: HTTP Referrers & Maps JavaScript API.
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_MAP_ID=""


# Server-to-server only. Never expose this in VITE_* or browser code.
OPERATOR_API_SECRET=""
# Offline local smoke tests
DISABLE_FIRESTORE=false
PORT=3000
