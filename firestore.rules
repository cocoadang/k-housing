rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Query-only service. Ingestion must use a dedicated server identity and IAM.
    match /{collection}/{document} {
      allow read: if collection in ['complexes', 'transactions', 'monthlyComplexPrices', 'monthlyComplexPrices_v2', 'monthlyStandardAreaPrices_v2'];
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
